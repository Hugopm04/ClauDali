# ClauDali local state — never committed
.venv/
# Anchored to the project root: unanchored, these also hid every
# site-packages/*/models/ directory from search tools.
/models/
/outputs/
/runs/
*.safetensors
*.ckpt
*.bin
*.pt

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/

# Local config overrides
claudali.local.toml
.env

# OS
Thumbs.db
desktop.ini
.DS_Store

# Installer log
install.log

# Benchmark output. The plan, the specs and the run state are all rebuilt by
# `python -m bench plan`, and the images are gigabytes, so none of it belongs
# in the repository. What defines the benchmark -- bench/topics/*.yaml and the
# code -- is committed; what it produces is not.
/bench/runs/
/bench/specs/
/bench/report/
/bench/logs/
/bench/assets/
/bench/plan.json
/bench/state.json
/bench/calibration.json
